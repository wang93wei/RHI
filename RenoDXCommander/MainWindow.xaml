                                        <TextBlock Text="{Binding [Card.Browse], Source={StaticResource Loc}}" TextDecorations="Underline" HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>



                        <!-- ── Component status table ── -->
                        <Border x:Name="DetailComponentSection" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12">
