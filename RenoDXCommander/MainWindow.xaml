                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveRelimiter], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Display Commander row -->
                                <Grid x:Name="DetailDcRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailDcLabel" x:FieldModifier="internal" Grid.Column="0" Text="{Binding [Detail.DisplayCommander], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailDcStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailDcStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailDcInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="{Binding [Dialog.Info], Source={StaticResource Loc}}" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailDcInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDcButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDcIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="DcCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.DisplayCommanderSettings], Source={StaticResource Loc}}">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDcDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDcButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveDisplayCommander], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Labeled separator: optional components -->
                                <Grid x:Name="DetailOptionalSeparator" x:FieldModifier="internal" Margin="0,4,0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="{Binding [Detail.Optional], Source={StaticResource Loc}}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- OptiScaler row -->
                                <Grid x:Name="DetailOsRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailOsLabel" x:FieldModifier="internal" Grid.Column="0" Text="{Binding [Detail.OptiScaler], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailOsStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailOsStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailOsInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="{Binding [Dialog.Info], Source={StaticResource Loc}}" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailOsInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallOsButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailOsIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="OsCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.OptiscalerSettings], Source={StaticResource Loc}}">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailOsDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallOsButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveOptiscaler], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- DXVK row -->
                                <Grid x:Name="DetailDxvkRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailDxvkLabel" x:FieldModifier="internal" Grid.Column="0" Text="{Binding [Detail.DXVK], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailDxvkStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailDxvkStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailDxvkInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="{Binding [Dialog.Info], Source={StaticResource Loc}}" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="DxvkInfoButton_Click"/>
                                    <Button x:Name="DetailDxvkInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDxvkButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDxvkConfBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="DxvkCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.DxvkSettings], Source={StaticResource Loc}}">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDxvkDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDxvkButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveDxvk], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- No mod message -->
                                <Border x:Name="DetailNoModMsg" x:FieldModifier="internal" Visibility="Collapsed"
                                        Background="{StaticResource AccentPurpleBgBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding [Detail.NoRenoDX], Source={StaticResource Loc}}"
                                               FontSize="12" Foreground="{StaticResource TextDisabledBrush}" TextAlignment="Center"/>
                                </Border>

                                <!-- Progress bars -->
                                <StackPanel x:Name="DetailProgressSection" Spacing="4">
                                    <ProgressBar x:Name="DetailRefProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRefMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailRsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentTealDimBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailUlProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailUlMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDcProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDcMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailOsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailOsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDofFixProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDofFixMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDxvkProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDxvkMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailRdxProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRdxMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailLumaProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailLumaMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentGreenBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Game Overrides section ── -->
                        <Border x:Name="OverridesContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="OverridesPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Nvidia Profile Overrides section ── -->
                        <Border x:Name="NvidiaProfileContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfilePanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Management section (folder, reset, report) ── -->
                        <Border x:Name="ManagementContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="ManagementPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Compact Nav Arrows — overlaid on content area, visible only in Compact mode -->
                    <Button x:Name="CompactNavLeft"
                            Content="◀" Click="CompactNavLeft_Click"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Canvas.ZIndex="1"
                            Visibility="{x:Bind ViewModel.CompactViewVisibility, Mode=OneWay}"
                            Background="{StaticResource SurfaceInputBrush}"
                            Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" FontSize="18"
                            Padding="8,16" Margin="4,0"/>

                    <Button x:Name="CompactNavRight"
                            Content="▶" Click="CompactNavRight_Click"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Canvas.ZIndex="1"
                            Visibility="{x:Bind ViewModel.CompactViewVisibility, Mode=OneWay}"
                            Background="{StaticResource SurfaceInputBrush}"
                            Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" FontSize="18"
                            Padding="8,16" Margin="0,0,4,0"/>

                    <!-- Skeleton detail panel overlay (removed programmatically after first load) -->
                    <ScrollViewer x:Name="SkeletonDetailScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                        <StackPanel x:Name="SkeletonDetailPanel" Spacing="16"
                                    Padding="24,18,24,24"/>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!--  SETTINGS PANEL  -->
            <Grid x:Name="SettingsPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="SettingsBackBtn" Content="{Binding [Xaml.BackToGames], Source={StaticResource Loc}}"
                                Click="SettingsBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding [Common.Settings], Source={StaticResource Loc}}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,40" Spacing="14" MaxWidth="800"
                                HorizontalAlignment="Center">

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 0: LANGUAGE
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LanguageCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              SelectionChanged="LanguageCombo_SelectionChanged"
                                              ToolTipService.ToolTip="{Binding [Settings.Language.Tooltip], Source={StaticResource Loc}}">
                                        <ComboBoxItem Content="{Binding [Settings.Language.System], Source={StaticResource Loc}}" Tag="System"/>
                                        <ComboBoxItem Content="{Binding [Settings.Language.EnUS], Source={StaticResource Loc}}" Tag="en-US"/>
                                        <ComboBoxItem Content="{Binding [Settings.Language.ZhCN], Source={StaticResource Loc}}" Tag="zh-CN"/>
                                        <ComboBoxItem Content="{Binding [Settings.Language.ZhTW], Source={StaticResource Loc}}" Tag="zh-TW"/>
                                        <ComboBoxItem Content="{Binding [Settings.Language.JaJP], Source={StaticResource Loc}}" Tag="ja-JP"/>
                                        <ComboBoxItem Content="{Binding [Settings.Language.KoKR], Source={StaticResource Loc}}" Tag="ko-KR"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="1" x:Name="LanguageCoverageText" x:FieldModifier="internal"
                                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock Text="{Binding [Settings.Language.Tooltip], Source={StaticResource Loc}}"
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 1: GAME LIBRARY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Settings.ComponentUpdates], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Check For Updates -->
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="{Binding [Settings.CheckForUpdates], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Settings.CheckForUpdates.Tooltip], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="CheckForUpdatesBtn" Content="{Binding [Settings.CheckForUpdates], Source={StaticResource Loc}}"
                                            Click="CheckForUpdatesButton_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="{Binding [Xaml.CheckAllComponentsAndThe], Source={StaticResource Loc}}"/>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Automatic Updates -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="{Binding [Settings.AutomaticUpdates], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Settings.AutomaticUpdates.Tooltip], Source={StaticResource Loc}}"/>
                                    <ComboBox x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="{Binding [Xaml.AutomaticallyInstallReshadeRenodxRelimit], Source={StaticResource Loc}}"
                                              SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Dialog.No], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Content="{Binding [Dialog.Yes], Source={StaticResource Loc}}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2: RESHADE & DISPLAY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Xaml.ReshadeAmpDisplay], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ── Left: Screenshots & Hotkeys ── -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding [Xaml.ScreenshotsAmpHotkeys], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Settings.ScreenshotsHotkeys.Tooltip], Source={StaticResource Loc}}"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- ── Right: HDR & Peak Brightness ── -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{Binding [Xaml.HdrAmpPeakBrightness], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Settings.HDRPeak.Tooltip], Source={StaticResource Loc}}"/>
                                </StackPanel>

                                <!-- Row 1 Left: Screenshot path + Open -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal"
                                                 PlaceholderText="{Binding [Settings.ScreenshotPath.Placeholder], Source={StaticResource Loc}}"
                                                 FontSize="12" Padding="12,8,36,8"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"/>
                                        <Button Click="BrowseScreenshotPath_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="8,6" MinWidth="0" MinHeight="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                ToolTipService.ToolTip="{Binding [Xaml.PickAFolderForScreenshots], Source={StaticResource Loc}}">
                                            <FontIcon Glyph="&#xED25;" FontSize="14"
                                                      Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </Button>
                                    </Grid>
                                    <Button Grid.Column="1" Content="{Binding [Xaml.Open], Source={StaticResource Loc}}" Click="OpenScreenshotFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"
                                            ToolTipService.ToolTip="{Binding [Xaml.OpenTheScreenshotFolderIn], Source={StaticResource Loc}}"/>
                                </Grid>

                                <!-- Row 1 Right: Peak Nits -->
                                <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [Dialog.PeakNits.Title], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="PeakNitsAutoBtn"
                                            Content="{Binding [Xaml.Auto], Source={StaticResource Loc}}" Click="PeakNitsAuto_Click"
                                            Background="{StaticResource AccentBlueBgBrush}"
                                            Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,5" FontSize="12"
                                            ToolTipService.ToolTip="{Binding [Xaml.ReadsYourMonitorSPeak], Source={StaticResource Loc}}"/>
                                    <TextBox Grid.Column="2" x:Name="PeakNitsBox" x:FieldModifier="internal"
                                             PlaceholderText="{Binding [Settings.PeakNits.Placeholder], Source={StaticResource Loc}}" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             KeyDown="PeakNitsBox_KeyDown"/>
                                    <Button Grid.Column="3" Content="⚙" Click="PeakNitsCog_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource ChipTextBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                            FontSize="12" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding [Xaml.ConfigureWhichPresetsReceiveThe], Source={StaticResource Loc}}"/>
                                </Grid>

                                <!-- Row 2 Left: Overlay key | Screenshot key | Per-Game Folders combo -->
                                <Grid Grid.Row="2" Grid.Column="0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="{Binding [Settings.OverlayKey], Source={StaticResource Loc}}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="{Binding [Settings.ScreenshotKey], Source={StaticResource Loc}}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="{Binding [Xaml.Subfolders], Source={StaticResource Loc}}" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="HotkeyBox" x:FieldModifier="internal"
                                             PlaceholderText="{Binding [Xaml.PressAKey], Source={StaticResource Loc}}" IsReadOnly="True" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="ScreenshotHotkeyBox" x:FieldModifier="internal"
                                                 PlaceholderText="{Binding [Xaml.PressAKey], Source={StaticResource Loc}}" IsReadOnly="True" FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                                 PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown"/>
                                        <Button Grid.Column="1" Content="↺" Click="ResetScreenshotHotkey_Click"
                                                ToolTipService.ToolTip="{Binding [Xaml.ResetToPrintScreen], Source={StaticResource Loc}}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="6,4" MinWidth="0" MinHeight="0" FontSize="14"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PerGameScreenshotCombo" x:FieldModifier="internal"
                                              FontSize="12" MinWidth="60"
                                              ToolTipService.ToolTip="{Binding [Xaml.WhenOnEachGameGets], Source={StaticResource Loc}}"
                                              SelectionChanged="PerGameScreenshotCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Row 2 Right: Apply to All Games (nits) -->
                                <Button Grid.Row="2" Grid.Column="2" x:Name="ApplyScreenshotPathBtn"
                                        Content="{Binding [Xaml.ApplyToAllGames], Source={StaticResource Loc}}"
                                        Click="ApplyPeakNitsToAll_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>
                                <!-- Row 4 Right: HDR Auto-Toggle + Select Monitors -->
                                <Grid Grid.Row="4" Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [Xaml.HdrAutoToggle], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="HdrAutoToggleCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{Binding [Xaml.WhenOnWindowsHdrIs], Source={StaticResource Loc}}"
                                              SelectionChanged="HdrAutoToggleCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="⚙" Click="HdrSelectMonitors_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource ChipTextBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                            FontSize="12" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding [Xaml.SelectWhichMonitorsToEnable], Source={StaticResource Loc}}"/>
                                </Grid>

                                <!-- Row 3 Left: Effect list style -->
                                <Grid Grid.Row="3" Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [Xaml.EffectListStyle], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="RsVariableListUseTabsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="{Binding [Xaml.ControlsHowShadersAreDisplayed], Source={StaticResource Loc}}"
                                              SelectionChanged="RsVariableListUseTabsCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Xaml.Tabs], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Content="{Binding [Xaml.Tree], Source={StaticResource Loc}}"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Row 4: Apply buttons -->
                                <Button Grid.Row="4" Grid.Column="0" x:Name="ApplyHotkeyBtn" x:FieldModifier="internal"
                                        Content="{Binding [Xaml.ApplyToAllGames], Source={StaticResource Loc}}"
                                        Click="ApplyScreenshotPath_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2b: RESOLUTION CONTROL (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="ResolutionControlCard" x:FieldModifier="internal"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding [Xaml.ResolutionControl], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Grid ColumnSpacing="0" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Left: description -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.TargetResolution], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.DesktopResolutionToSwitchTo], Source={StaticResource Loc}}"/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1"
                                            Background="{StaticResource BorderDefaultBrush}"
                                            VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                    <!-- Right: Auto-Toggle On/Off + cog -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.ResolutionAutoToggle], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.WhenOnSwitchesToThe], Source={StaticResource Loc}}"/>
                                    </StackPanel>

                                    <!-- Row 1 Left: Resolution picker ComboBox -->
                                    <ComboBox Grid.Row="1" Grid.Column="0"
                                              x:Name="ResolutionTargetCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="{Binding [Xaml.SelectTheTargetDesktopResolution], Source={StaticResource Loc}}"
                                              SelectionChanged="ResolutionTargetCombo_SelectionChanged"/>

                                    <!-- Row 1 Right: Auto-Toggle combo + cog -->
                                    <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [Xaml.ResolutionAutoToggle], Source={StaticResource Loc}}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="ResAutoToggleCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="{Binding [Xaml.WhenOnSwitchesDesktopResolution], Source={StaticResource Loc}}"
                                                  SelectionChanged="ResAutoToggleCombo_SelectionChanged">
                                            <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="⚙" Click="ResSelectMonitors_Click"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="12" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{Binding [Xaml.SelectWhichMonitorsToChange], Source={StaticResource Loc}}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2c: NEXUS MODS (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="NexusModsCard" x:FieldModifier="internal"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding [Xaml.NexusMods], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <Grid ColumnSpacing="0" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Left description -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.ApiKey], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.PasteYourNexusModsPersonal], Source={StaticResource Loc}}"/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
                                            Background="{StaticResource BorderDefaultBrush}"
                                            VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                    <!-- Right: connection status + NXM toggle -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.NxmProtocolHandler], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.RegisterRhiAsTheNxm], Source={StaticResource Loc}}"/>
                                    </StackPanel>

                                    <!-- Row 1 Left: API key input + Connect/Disconnect buttons -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="NexusApiKeyBox" x:FieldModifier="internal"
                                                         Grid.Column="0"
                                                         PlaceholderText="{Binding [Xaml.PasteApiKeyHere], Source={StaticResource Loc}}"
                                                         FontSize="12" VerticalAlignment="Center"
                                                         PasswordRevealMode="Peek"/>
                                            <Button x:Name="NexusConnectBtn" x:FieldModifier="internal"
                                                    Grid.Column="1"
                                                    Content="{Binding [Xaml.Connect], Source={StaticResource Loc}}"
                                                    Click="NexusConnectBtn_Click"
                                                    Background="{StaticResource AccentGreenBrush}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="6" Padding="12,6" MinWidth="0"
                                                    FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="NexusStatusText" x:FieldModifier="internal"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Text="{Binding [Xaml.NotConnected], Source={StaticResource Loc}}"/>
                                    </StackPanel>

                                    <!-- Row 1 Right: NXM handler register/unregister -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NxmStatusText" x:FieldModifier="internal"
                                                       Grid.Column="0"
                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding [Xaml.NotRegistered], Source={StaticResource Loc}}"/>
                                            <Button x:Name="NxmRegisterBtn" x:FieldModifier="internal"
                                                    Grid.Column="1"
                                                    Content="{Binding [Xaml.Register], Source={StaticResource Loc}}"
                                                    Click="NxmRegisterBtn_Click"
                                                    Background="{StaticResource SurfaceOverlayBrush}"
                                                    Foreground="{StaticResource ChipTextBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="12,6" MinWidth="0"
                                                    FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2: Disconnect row (shown only when connected) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" x:Name="NexusDisconnectRow" x:FieldModifier="internal" Visibility="Collapsed">
                                        <Button Content="{Binding [Xaml.Disconnect], Source={StaticResource Loc}}"
                                                Click="NexusDisconnectBtn_Click"
                                                Background="Transparent"
                                                Foreground="{StaticResource AccentRedBrush}"
                                                BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="12,4" MinWidth="0"
                                                FontSize="11" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 3: DLSS & STREAMLINE
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Xaml.DlssStreamlineSettings], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Defaults + DMFG Defaults + Batch Deploy -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="{Binding [Xaml.Defaults], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.ConfigurePreferredDlssStreamlineVersions], Source={StaticResource Loc}}"/>
                                        <Button Content="{Binding [Xaml.ConfigureDefaults], Source={StaticResource Loc}}" Click="DlssDefaults_Click"
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <StackPanel x:Name="DlssDefaultsSummaryPanel" x:FieldModifier="internal" Spacing="4" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- DMFG Defaults (global base profile) -->
                                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                                        <TextBlock Text="{Binding [Xaml.DmfgDefaults], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.GlobalDynamicMultiFrameGeneration], Source={StaticResource Loc}}"/>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding [Xaml.FrameCount], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                                <ComboBox x:Name="DmfgFrameCountCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalDmfgMaxFrameCount], Source={StaticResource Loc}}"
                                                          SelectionChanged="DmfgFrameCountCombo_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding [Xaml.TargetFps], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                                <ComboBox x:Name="DmfgTargetFpsCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalDmfgTargetFrameRate], Source={StaticResource Loc}}"
                                                          SelectionChanged="DmfgTargetFpsCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                                        <TextBlock Text="{Binding [Xaml.BatchDeploy], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.DeployDlssAndStreamlineDll], Source={StaticResource Loc}}"/>
                                        <Button Content="{Binding [Xaml.BatchDeploy], Source={StaticResource Loc}}" Click="MassDlssDeploy_Click"
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderSubtleBrush}" Margin="16,0"/>

                                <!-- Right: DLSS & G-Sync Indicators + Auto-Update -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="{Binding [Xaml.DlssOnScreenIndicator], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Xaml.ControlsTheDlssTextOverlay], Source={StaticResource Loc}}"/>
                                    <ComboBox x:Name="DlssIndicatorCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              SelectionChanged="DlssIndicatorCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Xaml.Enabled], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Content="{Binding [Xaml.Disabled], Source={StaticResource Loc}}"/>
                                    </ComboBox>

                                    <TextBlock Text="{Binding [Xaml.GSyncOnScreenIndicator], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="GSyncIndicatorCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              SelectionChanged="GSyncIndicatorCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Xaml.Enabled], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Content="{Binding [Xaml.Disabled], Source={StaticResource Loc}}"/>
                                    </ComboBox>

                                    <TextBlock Text="{Binding [Xaml.AutoUpdate], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Xaml.AutomaticallySwapToTheNewest], Source={StaticResource Loc}}"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
