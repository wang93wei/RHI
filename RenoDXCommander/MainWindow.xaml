                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="DofFixInfoButton_Click"/>
                                    <Button x:Name="DetailDofFixInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDofFixButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDofFixCogBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Visibility="Collapsed"
                                            Click="DofFixCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.DofFixSettings], Source={StaticResource Loc}}">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDofFixDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDofFixButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveDofFix], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Labeled separator: choose one limiter -->
                                <Grid Margin="0,4,0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="{Binding [Detail.FrameLimiters], Source={StaticResource Loc}}" FontSize="11"
                                               ToolTipService.ToolTip="{Binding [MainWindow.ReLimiterDisplayCommanderBothLimit], Source={StaticResource Loc}}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ReLimiter row -->
                                <Grid x:Name="DetailUlRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailUlLabel" x:FieldModifier="internal" Grid.Column="0" Text="{Binding [Detail.ReLimiter], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailUlStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailUlStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailUlInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="{Binding [Dialog.Info], Source={StaticResource Loc}}" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailUlInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallUlButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailUlIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="UlCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RelimiterSettings], Source={StaticResource Loc}}">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailUlDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallUlButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveRelimiter], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Display Commander row -->
                                <Grid x:Name="DetailDcRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailDcLabel" x:FieldModifier="internal" Grid.Column="0" Text="{Binding [Detail.DisplayCommander], Source={StaticResource Loc}}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailDcStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailDcStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailDcInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="{Binding [Dialog.Info], Source={StaticResource Loc}}" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailDcInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDcButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDcIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="DcCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.DisplayCommanderSettings], Source={StaticResource Loc}}">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDcDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDcButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding [Xaml.RemoveDisplayCommander], Source={StaticResource Loc}}" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- No mod message -->
                                <Border x:Name="DetailNoModMsg" x:FieldModifier="internal" Visibility="Collapsed"
                                        Background="{StaticResource AccentPurpleBgBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding [Detail.NoRenoDX], Source={StaticResource Loc}}"
                                               FontSize="12" Foreground="{StaticResource TextDisabledBrush}" TextAlignment="Center"/>
                                </Border>

                                <!-- Progress bars -->
                                <StackPanel x:Name="DetailProgressSection" Spacing="4">
                                    <ProgressBar x:Name="DetailRefProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRefMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailRsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentTealDimBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailUlProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailUlMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDcProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDcMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDofFixProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDofFixMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDxvkProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDxvkMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailRdxProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRdxMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailLumaProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailLumaMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentGreenBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                                </StackPanel><!-- /DetailComponentsBody -->
                            </StackPanel>
                        </Border>

                        <!-- ── Game Overrides section ── -->
                        <Border x:Name="OverridesContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <!-- Collapse header — wired in BuildOverridesPanel -->
                                <StackPanel x:Name="OverridesHeaderRow" x:FieldModifier="internal"
                                            Orientation="Horizontal" Spacing="0"/>
                                <!-- Body — all overrides content added here by builder -->
                                <StackPanel x:Name="OverridesPanel" x:FieldModifier="internal" Spacing="6"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Neural Rendering section ── -->
                        <Border x:Name="NeuralRenderingContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NeuralRenderingPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── DLSS / Streamline section ── -->
                        <Border x:Name="NvidiaProfileDlssContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDlssPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Driver Settings section ── -->
                        <Border x:Name="NvidiaProfileDriverContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDriverPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Legacy container — kept for migration, never shown ── -->
                        <Border x:Name="NvidiaProfileContainer" x:FieldModifier="internal"
                                Visibility="Collapsed"/>

                        <!-- ── Management section (folder, reset, report) ── -->
                        <Border x:Name="ManagementContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="ManagementPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>
                        <!-- ── Extras section ── -->
                        <Border x:Name="ExtrasContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="ExtrasPanel" x:FieldModifier="internal" Spacing="6"/>
                                <ProgressBar x:Name="DetailOsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                             Maximum="100" Height="3" CornerRadius="2"
                                             Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                <TextBlock x:Name="DetailOsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Skeleton detail panel overlay (removed programmatically after first load) -->
                    <ScrollViewer x:Name="SkeletonDetailScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                        <StackPanel x:Name="SkeletonDetailPanel" Spacing="16"
                                    Padding="24,18,24,24"/>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!--  SETTINGS PANEL  -->
            <Grid x:Name="SettingsPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="{StaticResource SurfaceHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button x:Name="SettingsBackBtn" Content="{Binding [Xaml.BackToGames], Source={StaticResource Loc}}"
                                Click="SettingsBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding [Common.Settings], Source={StaticResource Loc}}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [MainWindow.MostSettingsSaveSoonChange], Source={StaticResource Loc}}"
                                   FontSize="12" Foreground="{StaticResource SettingsHelpBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <!-- Width and alignment are set from C# (SettingsHandler.Navigation) once the section list is added -->
                    <StackPanel x:Name="SettingsCardsPanel" x:FieldModifier="internal"
                                Padding="32,24,32,40" Spacing="28" MaxWidth="1000"
                                HorizontalAlignment="Center">
                        <!-- Settings buttons keep their own text colour on hover/press (the hover shows through the
                             background). WinUI could leave the hover text colour stuck after the pointer left. -->
                        <StackPanel.Resources>
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsLabelBrush"/>
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsLabelBrush"/>
                        </StackPanel.Resources>

                        <!-- ══════════════════════════════════════════════════════════
                             SETTINGS SECTIONS — each section is an unnamed StackPanel with
                             Tag="Section:<Key>" (found from C# by Tag, never by x:Name).
                             Keys: General, Accounts, ReShade, Display, Dlss, Driver, Components, Tools.
                             New settings go into the matching section.
                             ══════════════════════════════════════════════════════════ -->

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 1: GENERAL
                             Layout follows the agreed mock-up: cards with two columns of
                             label-left / control-right rows (styles in Themes/DarkTheme.xaml).
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:General" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.General.UpdatesHowRHIBehavesPC], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Language -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox Grid.Column="1" x:Name="LanguageCombo" x:FieldModifier="internal"
                                                  Style="{StaticResource SettingsComboStyle}"
                                                  SelectionChanged="LanguageCombo_SelectionChanged"
                                                  ToolTipService.ToolTip="{Binding [Settings.Language.Tooltip], Source={StaticResource Loc}}">
                                            <ComboBoxItem Content="{Binding [Settings.Language.System], Source={StaticResource Loc}}" Tag="System"/>
                                            <ComboBoxItem Content="{Binding [Settings.Language.EnUS], Source={StaticResource Loc}}" Tag="en-US"/>
                                            <ComboBoxItem Content="{Binding [Settings.Language.ZhCN], Source={StaticResource Loc}}" Tag="zh-CN"/>
                                            <ComboBoxItem Content="{Binding [Settings.Language.ZhTW], Source={StaticResource Loc}}" Tag="zh-TW"/>
                                            <ComboBoxItem Content="{Binding [Settings.Language.JaJP], Source={StaticResource Loc}}" Tag="ja-JP"/>
                                            <ComboBoxItem Content="{Binding [Settings.Language.KoKR], Source={StaticResource Loc}}" Tag="ko-KR"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock x:Name="LanguageCoverageText" x:FieldModifier="internal"
                                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                               Text="{Binding [Settings.Language.Tooltip], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Updates -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Xaml.Updates], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Check for updates (countdown is inserted above the note in C#) + Components to check -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.General.CheckUpdates], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.General.RHIChecksEvery4Hours], Source={StaticResource Loc}}"/>
                                            <Button x:Name="CheckForUpdatesBtn" Content="{Binding [Settings.General.CheckUpdates], Source={StaticResource Loc}}"
                                                    Click="CheckForUpdatesButton_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Xaml.CheckAllComponentsAndThe], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.General.BackgroundChecks], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="BackgroundUpdateChecksCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          SelectionChanged="BackgroundUpdateChecksCombo_SelectionChanged">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock TextWrapping="Wrap" MaxWidth="280">
                                                                <Run Text="{Binding [Xaml.BackgroundChecks.On.Tooltip], Source={StaticResource Loc}}"/><LineBreak/>
                                                                <Run Text="{Binding [Xaml.BackgroundChecks.Minimal.Tooltip], Source={StaticResource Loc}}"/>
                                                            </TextBlock>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Xaml.Minimal], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="{Binding [Settings.General.ComponentsCheck], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="{Binding [Xaml.DisableUpdateChecksForIndividual], Source={StaticResource Loc}}"/>
                                            <TextBlock x:Name="GlobalUpdateSummaryText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsStatusStyle}"/>
                                            <Button x:Name="GlobalUpdateInclusionBtn"
                                                    Content="{Binding [Settings.General.Choose], Source={StaticResource Loc}}"
                                                    Click="GlobalUpdateInclusion_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.General.ChooseWhichComponentsRHIChecks], Source={StaticResource Loc}}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Automatic updates (Components, DLSS, Streamline) -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.General.AutomaticUpdates], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Detail.Components], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.General.WhenRHISilentlyInstallsComponent], Source={StaticResource Loc}}"
                                                          SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="{Binding [Settings.General.ReShadeRenoDXReLimiterDisplayCommander], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.Dlss], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateDlssCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.General.SwapsGamesNewestDLSSWhen], Source={StaticResource Loc}}"
                                                          SelectionChanged="AutoUpdateDlssCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.Streamline], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateStreamlineCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.General.SwapsGamesNewestStreamlineWhen], Source={StaticResource Loc}}"
                                                          SelectionChanged="AutoUpdateStreamlineCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.General.RHISOwnUpdatesNever], Source={StaticResource Loc}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Windows and Admin Mode -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.General.WindowsAdminMode], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Windows (system tray, start with Windows) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.General.Windows], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.General.CloseTray], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CloseToTrayCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.General.ClosingWindowKeepsRHIRunning], Source={StaticResource Loc}}"
                                                          SelectionChanged="CloseToTrayCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.General.RecentGamesTrayMenu], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RecentGamesCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.General.RightClickTrayIconPinned], Source={StaticResource Loc}}"
                                                          SelectionChanged="RecentGamesCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.StartWithWindows], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="StartWithWindowsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          SelectionChanged="StartWithWindowsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Admin Mode + Drop Helper -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Dialog.AdminMode.Title], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.General.RunsRHIAdministratorWithoutPrompt], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Dialog.AdminMode.Title], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AdminModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.General.CreatesScheduledTaskLaunchesRHI], Source={StaticResource Loc}}"
                                                          SelectionChanged="AdminModeCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [Xaml.DropHelper], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="{Binding [Settings.General.OnlyUsedWhenAdminMode], Source={StaticResource Loc}}">
                                                        <TextBlock Text="{Binding [Settings.General.Admin], Source={StaticResource Loc}}" FontSize="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="DropHelperCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.TheDropHelperWindowEnables], Source={StaticResource Loc}}"
                                                          SelectionChanged="DropHelperCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 2: ACCOUNTS & DATA
                             (RenoDxDbSourceCard is made visible in SettingsHandler; NexusModsCard
                             is shown when FeatureFlags.NexusMods is on: dev unlock or manifest flag)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Accounts" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Accounts.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.Accounts.WhereRHIGetsItsMod], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border x:Name="RenoDxDbSourceCard" x:FieldModifier="internal"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Accounts.AccountsModData], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: GitHub token -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.Accounts.GitHubToken], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       ToolTipService.ToolTip="{Binding [Settings.Accounts.TokenRaisesGitHubAPIRate], Source={StaticResource Loc}}"
                                                       Text="{Binding [Settings.Accounts.WithoutTokenRHILimited60], Source={StaticResource Loc}}"/>

                                            <!-- Status text (connected / code display / error) -->
                                            <TextBlock x:Name="GitHubStatusText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsStatusStyle}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Text="{Binding [Settings.Accounts.NotConnected60ReqHr], Source={StaticResource Loc}}"/>

                                            <!-- Personal Access Token -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Accounts.Token], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="GitHubPatBox" x:FieldModifier="internal"
                                                             PlaceholderText="{Binding [Settings.GitHub.Pat.Placeholder], Source={StaticResource Loc}}"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             IsSpellCheckEnabled="False"
                                                             InputScope="Url"
                                                             ToolTipService.ToolTip="{Binding [Settings.Accounts.PasteGitHubPersonalAccessToken], Source={StaticResource Loc}}"/>
                                                    <Button Grid.Column="1" x:Name="GitHubPatSaveBtn" x:FieldModifier="internal"
                                                            Content="{Binding [Dialog.Save], Source={StaticResource Loc}}"
                                                            Click="GitHubPatSaveBtn_Click"
                                                            Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock x:Name="GitHubPatStatusText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsNoteStyle}"
                                                       Text="" Visibility="Collapsed"/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <HyperlinkButton NavigateUri="https://github.com/settings/tokens/new?description=RHI&amp;scopes="
                                                                 Content="{Binding [Settings.Accounts.CreateToken], Source={StaticResource Loc}}"
                                                                 FontSize="12" MinHeight="30" Padding="12,5" CornerRadius="8"
                                                                 BorderThickness="1"
                                                                 Background="{StaticResource SurfaceOverlayBrush}"
                                                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 ToolTipService.ToolTip="{Binding [Settings.Accounts.OpensGithubComSettingsTokens], Source={StaticResource Loc}}"/>
                                                <Button x:Name="GitHubPatClearBtn" x:FieldModifier="internal"
                                                        Content="{Binding [Dialog.Remove], Source={StaticResource Loc}}"
                                                        Click="GitHubPatClearBtn_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="{Binding [Settings.Accounts.RemoveSavedToken], Source={StaticResource Loc}}">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <!-- Disconnect — shown only when signed in -->
                                                <StackPanel x:Name="GitHubDisconnectRow" x:FieldModifier="internal"
                                                            Visibility="Collapsed">
                                                    <Button Content="{Binding [Settings.Accounts.SignOut], Source={StaticResource Loc}}"
                                                            Click="GitHubDisconnectBtn_Click"
                                                            Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                            ToolTipService.ToolTip="{Binding [Settings.Accounts.SignOutGitHub], Source={StaticResource Loc}}">
                                                        <Button.Resources>
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Mod data source + Nexus Mods -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.Accounts.ModDataSource], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.Source], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RenoDxDbSourceCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Accounts.RHIDatabaseUsesCommunityMaintained], Source={StaticResource Loc}}">
                                                    <ComboBoxItem Content="{Binding [Xaml.RhiDatabase], Source={StaticResource Loc}}" Tag="DbOnly"/>
                                                    <ComboBoxItem Content="{Binding [Menu.RenoDxWiki], Source={StaticResource Loc}}" Tag="WikiOnly"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="{Binding [Settings.Accounts.WhereRHILooksUpWhich], Source={StaticResource Loc}}"/>

                                            <!-- Nexus Mods (shown when FeatureFlags.NexusMods is on) -->
                                            <Border x:Name="NexusModsCard" x:FieldModifier="internal"
                                                    Visibility="Collapsed">
                                                <StackPanel Spacing="9">
                                                    <TextBlock Text="{Binding [Xaml.NexusMods], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                                    <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                               Text="{Binding [Settings.Accounts.ConnectSignsNexusModsBrowser], Source={StaticResource Loc}}"/>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding [Settings.Accounts.Account], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="NexusStatusText" x:FieldModifier="internal"
                                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                                       Text="{Binding [Xaml.NotConnected], Source={StaticResource Loc}}"/>
                                                            <Button Grid.Column="1" x:Name="NexusConnectBtn" x:FieldModifier="internal"
                                                                    Content="{Binding [Xaml.Connect], Source={StaticResource Loc}}"
                                                                    Click="NexusConnectBtn_Click"
                                                                    ToolTipService.ToolTip="{Binding [Settings.Accounts.SignNexusModsBrowserSo], Source={StaticResource Loc}}"
                                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <StackPanel x:Name="NexusDisconnectRow" x:FieldModifier="internal"
                                                                Visibility="Collapsed" HorizontalAlignment="Right">
                                                        <Button Content="{Binding [Xaml.Disconnect], Source={StaticResource Loc}}"
                                                                Click="NexusDisconnectBtn_Click"
                                                                ToolTipService.ToolTip="{Binding [Settings.Accounts.SignOutNexusModsRemove], Source={StaticResource Loc}}"
                                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}">
                                                            <Button.Resources>
                                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding [Settings.Accounts.NxmLinks], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"
                                                                   ToolTipService.ToolTip="{Binding [Settings.Accounts.RegisterRHINxmHandlerSo], Source={StaticResource Loc}}"/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="NxmStatusText" x:FieldModifier="internal"
                                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding [Xaml.NotRegistered], Source={StaticResource Loc}}"/>
                                                            <Button Grid.Column="1" x:Name="NxmRegisterBtn" x:FieldModifier="internal"
                                                                    Content="{Binding [Xaml.Register], Source={StaticResource Loc}}"
                                                                    Click="NxmRegisterBtn_Click"
                                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                                    ToolTipService.ToolTip="{Binding [Settings.Accounts.OpenNexusModManagerDownload], Source={StaticResource Loc}}"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 3: RESHADE & RENODX
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:ReShade" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.ReShade.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.ReShade.DefaultsEveryGameUsingReShade], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Keys, screenshots and brightness -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.ReShade.KeysScreenshotsBrightness], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Keys and screenshots -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.ReShade.KeysScreenshots], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="{Binding [Settings.ScreenshotsHotkeys.Tooltip], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.OverlayKey], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBox Grid.Column="1" x:Name="HotkeyBox" x:FieldModifier="internal"
                                                         PlaceholderText="{Binding [Xaml.PressAKey], Source={StaticResource Loc}}" IsReadOnly="True"
                                                         Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                         ToolTipService.ToolTip="{Binding [Settings.ReShade.OpensReShadeOverlayGameClick], Source={StaticResource Loc}}"
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.ScreenshotKey], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ScreenshotHotkeyBox" x:FieldModifier="internal"
                                                             PlaceholderText="{Binding [Xaml.PressAKey], Source={StaticResource Loc}}" IsReadOnly="True"
                                                             Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                             ToolTipService.ToolTip="{Binding [Xaml.ScreenshotHotkey.Tooltip], Source={StaticResource Loc}}"
                                                             PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown"/>
                                                    <Button Grid.Column="1" Content="↺" Click="ResetScreenshotHotkey_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.ResetToPrintScreen], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.ReShade.ScreenshotFolder], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal"
                                                             PlaceholderText="{Binding [Settings.ReShade.TypeChooseFolder], Source={StaticResource Loc}}"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="{Binding [Settings.ReShade.WhereReShadeSavesScreenshotsType], Source={StaticResource Loc}}"
                                                             KeyDown="ScreenshotPathBox_KeyDown"
                                                             LostFocus="ScreenshotPathBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="{Binding [Card.Browse], Source={StaticResource Loc}}" Click="BrowseScreenshotPath_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.PickAFolderForScreenshots], Source={StaticResource Loc}}"/>
                                                    <Button Grid.Column="2" Content="{Binding [Xaml.Open], Source={StaticResource Loc}}" Click="OpenScreenshotFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.OpenTheScreenshotFolderIn], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.ReShade.FolderPerGame], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="PerGameScreenshotCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.WhenOnEachGameGets], Source={StaticResource Loc}}"
                                                          SelectionChanged="PerGameScreenshotCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.EffectListStyle], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RsVariableListUseTabsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.ControlsHowShadersAreDisplayed], Source={StaticResource Loc}}"
                                                          SelectionChanged="RsVariableListUseTabsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Xaml.Tabs], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Xaml.Tree], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyHotkeyBtn" x:FieldModifier="internal"
                                                    Content="{Binding [Settings.ReShade.WriteTheseGames], Source={StaticResource Loc}}"
                                                    Click="ApplyScreenshotPath_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.ReShade.WritesOverlayKeyScreenshotKey], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.ReShade.SkipsHiddenGamesGamesSet], Source={StaticResource Loc}}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: HDR brightness (RenoDX) -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.ReShade.HDRBrightnessRenoDX], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.ReShade.PeakBrightness], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PeakNitsBox" x:FieldModifier="internal"
                                                             PlaceholderText="{Binding [Settings.PeakNits.Placeholder], Source={StaticResource Loc}}"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="{Binding [Settings.ReShade.MonitorSPeakBrightnessNits], Source={StaticResource Loc}}"
                                                             KeyDown="PeakNitsBox_KeyDown"
                                                             LostFocus="PeakNitsBox_LostFocus"/>
                                                    <Button Grid.Column="1" x:Name="PeakNitsAutoBtn"
                                                            Content="{Binding [Xaml.Auto], Source={StaticResource Loc}}" Click="PeakNitsAuto_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.ReadsYourMonitorSPeak], Source={StaticResource Loc}}"/>
                                                    <Button Grid.Column="2" Content="⚙" Click="PeakNitsCog_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.ConfigureWhichPresetsReceiveThe], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                            <Button x:Name="ApplyScreenshotPathBtn"
                                                    Content="{Binding [Settings.ReShade.WritePeakBrightnessGames], Source={StaticResource Loc}}"
                                                    Click="ApplyPeakNitsToAll_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.ReShade.WritesPeakNitsValueInto], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Shaders and addons -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.ReShade.ShadersAddons], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Shader management + download all -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Dialog.Shaders], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CustomShadersCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.ReShade.RHIManagedDeployBuiltShader], Source={StaticResource Loc}}"
                                                          SelectionChanged="CustomShadersCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Xaml.RhiManaged], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Xaml.Custom], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="{Binding [Settings.ReShade.ChangingUpdatesEveryGameS], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.ReShade.DownloadShaders], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CacheAllShadersCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.WhenOnAllShaderPacks], Source={StaticResource Loc}}"
                                                          SelectionChanged="CacheAllShadersCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Addon watch folder -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.ReShade.AddonWatchFolder], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="AddonWatchFolderBox" x:FieldModifier="internal"
                                                             PlaceholderText="{Binding [Settings.ReShade.DownloadsDefault], Source={StaticResource Loc}}"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="{Binding [Xaml.RhiWatchesThisFolderFor], Source={StaticResource Loc}}"
                                                             KeyDown="AddonWatchFolderBox_KeyDown"
                                                             LostFocus="AddonWatchFolderBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="{Binding [Card.Browse], Source={StaticResource Loc}}" Click="BrowseAddonWatchFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Settings.ReShade.PickFolderRHIWatchesAddon], Source={StaticResource Loc}}"/>
                                                    <Button Grid.Column="2" Content="{Binding [Xaml.Reset], Source={StaticResource Loc}}" Click="ResetAddonWatchFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Settings.ReShade.GoBackDownloadsFolder], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="{Binding [Settings.ReShade.RHILooksHereRenoDXAddon], Source={StaticResource Loc}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 4: DISPLAY & HDR
                             (ResolutionControlCard and DldsrControlCard are shown when
                             FeatureFlags.ResolutionControl is on — currently always)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Display" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Display.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.Display.WhatHappensScreenWhenLaunch], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Display -->
                            <Border x:Name="ResolutionControlCard" x:FieldModifier="internal"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Display.Display], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: When a game starts (HDR + resolution auto-toggle, target resolution) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.Display.WhenGameStarts], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.Display.UndoneAutomaticallyWhenGameCloses], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Display.WindowsHDR], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="HdrAutoToggleCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="{Binding [Xaml.WhenOnWindowsHdrIs], Source={StaticResource Loc}}"
                                                              SelectionChanged="HdrAutoToggleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                        <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="⚙" Click="HdrSelectMonitors_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.SelectWhichMonitorsToEnable], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Display.ChangeResolution], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ResAutoToggleCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="{Binding [Xaml.WhenOnSwitchesToThe], Source={StaticResource Loc}}"
                                                              SelectionChanged="ResAutoToggleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                        <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="⚙" Click="ResSelectMonitors_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Settings.Display.SelectWhichMonitorsChangeResolution], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Display.Resolution], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ResolutionTargetCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.DesktopResolutionToSwitchTo], Source={StaticResource Loc}}"
                                                          SelectionChanged="ResolutionTargetCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Output colour -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.Display.OutputColour], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="{Binding [Xaml.OutputColourSettings.Description], Source={StaticResource Loc}}"/>
                                            <!-- Monitor row: C# hides the combo's parent row when no NVIDIA display is found -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Dialog.Monitor], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorDisplayCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.SelectDisplay.Tooltip], Source={StaticResource Loc}}"
                                                          SelectionChanged="ColorDisplayCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Display.ColourDepth], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorDepthCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Display.BitsPerColourChannelSent], Source={StaticResource Loc}}">
                                                    <ComboBoxItem Content="{Binding [Option.8 bpc], Source={StaticResource Loc}}" Tag="8 bpc"/>
                                                    <ComboBoxItem Content="{Binding [Option.10 bpc], Source={StaticResource Loc}}" Tag="10 bpc"/>
                                                    <ComboBoxItem Content="{Binding [Option.12 bpc], Source={StaticResource Loc}}" Tag="12 bpc"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Display.DynamicRange], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorRangeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Display.FullSuitsPCMonitorsLimited], Source={StaticResource Loc}}">
                                                    <ComboBoxItem Content="{Binding [Option.Full], Source={StaticResource Loc}}" Tag="Full"/>
                                                    <ComboBoxItem Content="{Binding [Option.Limited], Source={StaticResource Loc}}" Tag="Limited"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button Content="{Binding [Dialog.Apply], Source={StaticResource Loc}}"
                                                    x:Name="ColorApplyBtn" x:FieldModifier="internal"
                                                    Click="ColorApplyBtn_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.Display.ApplyColourDepthDynamicRange], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Display.DigitalVibrance], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Settings.Display.PerMonitor], Source={StaticResource Loc}}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource SettingsHelpBrush}"/>
                                                    <Button Grid.Column="1" Content="{Binding [Settings.Display.Adjust], Source={StaticResource Loc}}"
                                                            Click="DigitalVibrance_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="{Binding [Xaml.AdjustNvidiaDigitalVibranceColor], Source={StaticResource Loc}}"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: DLDSR -->
                            <Border x:Name="DldsrControlCard" x:FieldModifier="internal"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding [Settings.Display.DLDSR], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}" VerticalAlignment="Center"/>
                                            <Button x:Name="DldsrInfoBtn" x:FieldModifier="internal"
                                                    Content="ⓘ" Click="DldsrInfoBtn_Click"
                                                    Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                                                    CornerRadius="10" BorderThickness="1" FontSize="11"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource AccentBlueBorderBrush}"
                                                    Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="{Binding [Settings.Dldsr.Info.Tooltip], Source={StaticResource Loc}}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="{Binding [Settings.Display.TurnDLDSRDeepLearningDynamic], Source={StaticResource Loc}}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="9">
                                        <TextBlock Text="{Binding [Settings.Display.CurrentState], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                        <TextBlock x:Name="DldsrCurrentStateText" x:FieldModifier="internal"
                                                   Text="{Binding [Settings.Dldsr.NotChecked], Source={StaticResource Loc}}"
                                                   Style="{StaticResource SettingsStatusStyle}"/>

                                        <!-- Smoothness slider + Set -->
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding [Settings.Display.Smoothness], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBlock x:Name="DldsrSmoothnessValueText" x:FieldModifier="internal"
                                                           Text="" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="DldsrSmoothnessSlider" x:FieldModifier="internal"
                                                        Minimum="0" Maximum="100" StepFrequency="1" TickFrequency="10"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="{Binding [Settings.Display.AdjustDSRSmoothness0100], Source={StaticResource Loc}}"/>
                                                <Button Grid.Column="1"
                                                        x:Name="DldsrSmoothnessApplyBtn" x:FieldModifier="internal"
                                                        Content="{Binding [Settings.Dldsr.Set.Button], Source={StaticResource Loc}}" Click="DldsrSmoothnessApplyBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="{Binding [Settings.Display.ApplySelectedSmoothnessValueCauses], Source={StaticResource Loc}}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Saved state + Apply -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*" MaxWidth="300"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.Display.SavedState], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="DldsrStateCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Display.SelectPreviouslyCapturedDLDSRState], Source={StaticResource Loc}}"/>
                                                <Button Grid.Column="1"
                                                        x:Name="DldsrApplyBtn" x:FieldModifier="internal"
                                                        Content="{Binding [Dialog.Apply], Source={StaticResource Loc}}" Click="DldsrApplyBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="{Binding [Settings.Display.ApplySelectedDLDSRStateCauses], Source={StaticResource Loc}}"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource AccentAmberBrush}"
                                                   Text="{Binding [Settings.Display.ScreenGoesBlackAbout15], Source={StaticResource Loc}}"/>

                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button x:Name="DldsrCaptureBtn" x:FieldModifier="internal"
                                                    Content="{Binding [Settings.Display.CaptureCurrent], Source={StaticResource Loc}}" Click="DldsrCaptureBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.Display.CaptureCurrentDLDSRStateNVIDIA], Source={StaticResource Loc}}"/>
                                            <Button x:Name="DldsrDeleteBtn" x:FieldModifier="internal"
                                                    Content="{Binding [Dialog.Delete], Source={StaticResource Loc}}" Click="DldsrDeleteBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.Display.DeleteCurrentlySelectedSavedState], Source={StaticResource Loc}}"/>
                                            <Button x:Name="DldsrRefreshBtn" x:FieldModifier="internal"
                                                    Content="{Binding [Common.Refresh], Source={StaticResource Loc}}" Click="DldsrRefreshBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.Display.RefreshCurrentDLDSRStateRegistry], Source={StaticResource Loc}}"/>
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 5: DLSS / STREAMLINE
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Dlss" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Dlss.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.Dlss.MatchesDLSSStreamlineSectionEach], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Defaults (summary grid is built in C# by RefreshDlssDefaultsSummary) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Xaml.Defaults], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="{Binding [Settings.Dlss.VersionsPresetsRenderScalesQuick], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="9">
                                        <StackPanel x:Name="DlssDefaultsSummaryPanel" x:FieldModifier="internal" Spacing="4"/>
                                        <Button Content="{Binding [Settings.Dlss.ConfigureDefaults], Source={StaticResource Loc}}" Click="DlssDefaults_Click"
                                                Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource AccentBlueBrush}"
                                                ToolTipService.ToolTip="{Binding [Settings.Dlss.ChooseDLSSStreamlineVersionsPresets], Source={StaticResource Loc}}">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource AccentBlueBrush}"
                                                   Text="{Binding [Settings.Dlss.AutomaticDLSSStreamlineUpdatesGeneral], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card: Indicator, frame generation and batch deploy -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Dlss.IndicatorFrameGenerationBatchDeploy], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: DLSS indicator + Multi frame generation (DMFG global base profile) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [Settings.Dlss.DLSSIndicator], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="{Binding [Settings.Dlss.NeedsAdminModeGeneralWindows], Source={StaticResource Loc}}">
                                                        <TextBlock Text="{Binding [Settings.General.Admin], Source={StaticResource Loc}}" FontSize="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="DlssIndicatorCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.ControlsTheDlssTextOverlay], Source={StaticResource Loc}}"
                                                          SelectionChanged="DlssIndicatorCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="{Binding [Settings.Dlss.MultiFrameGenerationRTX50], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="{Binding [Settings.Dlss.GlobalDynamicMultiFrameGeneration], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Dlss.MaxFrames], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="DmfgFrameCountCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalDmfgMaxFrameCount], Source={StaticResource Loc}}"
                                                          SelectionChanged="DmfgFrameCountCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.TargetFps], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="DmfgTargetFpsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalDmfgTargetFrameRate], Source={StaticResource Loc}}"
                                                          SelectionChanged="DmfgTargetFpsCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Batch deploy -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Settings.Dlss.BatchDeploy], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.Dlss.PutDLSSStreamlineVersionsPresets], Source={StaticResource Loc}}"/>
                                            <Button Content="{Binding [Settings.Dlss.BatchDeploy], Source={StaticResource Loc}}" Click="MassDlssDeploy_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Xaml.DeployDlssAndStreamlineDll], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 6: DRIVER SETTINGS
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Driver" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Driver.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.Driver.DriverDefaultsEveryGameGame], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Driver defaults (NVAPI combos, populated with init guards in SettingsHandler) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Driver.DriverDefaults], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"
                                               ToolTipService.ToolTip="{Binding [Settings.Driver.DriverLevelSettingsAppliedGlobally], Source={StaticResource Loc}}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: VSync, frame rate, G-Sync, refresh rate -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.Vsync], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalVSyncCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalVsyncModeAppliesTo], Source={StaticResource Loc}}"
                                                          SelectionChanged="GlobalVSyncCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.FrameRateLimit], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="FpsLimitCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Driver.GlobalFPSCapViaNVIDIA], Source={StaticResource Loc}}"
                                                          SelectionChanged="FpsLimitCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.GSync], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncEnableCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GloballyEnablesOrDisablesG], Source={StaticResource Loc}}"
                                                          SelectionChanged="GSyncEnableCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.GSyncMode], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.ControlsGSyncFreesyncVariable], Source={StaticResource Loc}}"
                                                          SelectionChanged="GSyncModeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.GSyncIndicator], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncIndicatorCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Driver.ShowsNVIDIASGSync], Source={StaticResource Loc}}"
                                                          SelectionChanged="GSyncIndicatorCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.PreferredRefreshRate], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="PreferredRefreshRateCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.HighestAvailableForcesYourMax], Source={StaticResource Loc}}"
                                                          SelectionChanged="PreferredRefreshRateCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Power, shaders, ReBAR -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.PowerMode], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalPowerModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalPowerManagementModeApplies], Source={StaticResource Loc}}"
                                                          SelectionChanged="GlobalPowerModeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.ShaderCacheSize], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ShaderCacheSizeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.MaximumDiskSpaceForCompiled], Source={StaticResource Loc}}"
                                                          SelectionChanged="ShaderCacheSizeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.ShaderPreCompile], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ShaderPrecompileCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.AutoCompilesShadersInThe], Source={StaticResource Loc}}"
                                                          SelectionChanged="ShaderPrecompileCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [Xaml.Rebar], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <!-- Shown by C# (ReBarAdminWarning) when RHI isn't running as admin -->
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            Visibility="{Binding Visibility, ElementName=ReBarAdminWarning}"
                                                            ToolTipService.ToolTip="{Binding [Settings.Dlss.NeedsAdminModeGeneralWindows], Source={StaticResource Loc}}">
                                                        <TextBlock x:Name="ReBarAdminWarning" x:FieldModifier="internal"
                                                                   Text="{Binding [Settings.General.Admin], Source={StaticResource Loc}}" FontSize="10"
                                                                   Foreground="{StaticResource AccentAmberBrush}"
                                                                   Visibility="Collapsed"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="GlobalReBarEnableCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalResizableBarEnablesLarge], Source={StaticResource Loc}}"
                                                          SelectionChanged="GlobalReBarEnableCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Driver.ReBARSizeLimit], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalReBarSizeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.MaximumBarTransferSize1gb], Source={StaticResource Loc}}"
                                                          SelectionChanged="GlobalReBarSizeCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Profiles -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Dialog.Profiles], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: create / back up / restore profiles -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="{Binding [Settings.Profiles.CreateMissing], Source={StaticResource Loc}}"
                                                        Click="CreateMissingNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="{Binding [Settings.Driver.CreatesNVIDIADriverProfilesGames], Source={StaticResource Loc}}"/>
                                                <Button Content="{Binding [Settings.Profiles.Backup], Source={StaticResource Loc}}"
                                                        Click="ExportNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="{Binding [Settings.Driver.SavePerGameNVIDIAProfile], Source={StaticResource Loc}}"/>
                                                <Button Content="{Binding [Settings.Profiles.Restore], Source={StaticResource Loc}}"
                                                        Click="ImportNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="{Binding [Settings.Driver.RestorePerGameNVIDIAProfile], Source={StaticResource Loc}}"/>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Reset -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Xaml.Reset], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="{Binding [Settings.Driver.TheseCanTUndoneEach], Source={StaticResource Loc}}"/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="{Binding [Settings.Driver.ResetGameProfiles], Source={StaticResource Loc}}"
                                                        Click="ResetAllNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="{Binding [Xaml.RemovesAllPerGameNvidia], Source={StaticResource Loc}}">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="{Binding [Settings.Driver.ClearShaderCache], Source={StaticResource Loc}}"
                                                        Click="ClearNvidiaShaderCache_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="{Binding [Xaml.DeletesTheNvidiaDxcacheAnd], Source={StaticResource Loc}}">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 7: COMPONENTS (ReLimiter + OptiScaler)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Components" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Components.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.Components.DefaultsReLimiterOptiScalerEachGame], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Components.ReLimiterOptiScaler], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: ReLimiter -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Detail.ReLimiter], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="{Binding [Xaml.RelimiterOsdHotkeyAndGlobal], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.OverlayKey], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBox Grid.Column="1" x:Name="UlHotkeyBox" x:FieldModifier="internal"
                                                         PlaceholderText="{Binding [Xaml.PressAKey], Source={StaticResource Loc}}" IsReadOnly="True"
                                                         Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                         ToolTipService.ToolTip="{Binding [Xaml.TheKeyThatTogglesThe], Source={StaticResource Loc}}"
                                                         PreviewKeyDown="UlHotkeyBox_PreviewKeyDown"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Xaml.TargetFps], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlTargetFpsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.GlobalFpsCapWrittenTo], Source={StaticResource Loc}}"
                                                          SelectionChanged="UlTargetFpsCombo_SelectionChanged">
                                                    <!-- Items populated in code-behind -->
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Components.SharedPresets], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlSharedPresetsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.WhenOnAllGamesShare], Source={StaticResource Loc}}"
                                                          SelectionChanged="UlSharedPresetsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Components.DLSSHooks], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlDlssHooksCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Xaml.ShowsDlssQualityModeRender], Source={StaticResource Loc}}"
                                                          SelectionChanged="UlDlssHooksCombo_SelectionChanged">
                                                    <ComboBoxItem Content="{Binding [Option.Off], Source={StaticResource Loc}}"/>
                                                    <ComboBoxItem Content="{Binding [Option.On], Source={StaticResource Loc}}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyUlHotkeyBtn" x:FieldModifier="internal"
                                                    Content="{Binding [Settings.Components.WriteReLimiterGames], Source={StaticResource Loc}}"
                                                    Click="ApplyUlOsdHotkey_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.Components.WritesOverlayKeySharedPresets], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: OptiScaler -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [Detail.OptiScaler], Source={StaticResource Loc}}" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="{Binding [Xaml.GpuTypeDlssInputSettings], Source={StaticResource Loc}}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.Components.GPUType], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="OsGpuCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Components.GPUBrandPCRHIUses], Source={StaticResource Loc}}"
                                                          SelectionChanged="OsGpuCombo_SelectionChanged">
                                                    <x:String>NVIDIA</x:String>
                                                    <x:String>AMD</x:String>
                                                    <x:String>Intel</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <!-- DLSS inputs: shown by C# for AMD and Intel -->
                                            <StackPanel x:Name="OsDlssInputsPanel" x:FieldModifier="internal" Visibility="Collapsed">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*" MaxWidth="210"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Settings.Components.DLSSInputs], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <ComboBox Grid.Column="1" x:Name="OsDlssInputsCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="{Binding [Settings.Components.OptiScalerReportsNVIDIAGPUGame], Source={StaticResource Loc}}"
                                                              SelectionChanged="OsDlssInputsCombo_SelectionChanged">
                                                        <x:String>Off</x:String>
                                                        <x:String>On</x:String>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Settings.OverlayKey], Source={StaticResource Loc}}" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="OsHotkeyCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="{Binding [Settings.Components.KeyOpensOptiScalerOverlayGame], Source={StaticResource Loc}}"
                                                          SelectionChanged="OsHotkeyCombo_SelectionChanged">
                                                    <x:String>Insert</x:String>
                                                    <x:String>Home</x:String>
                                                    <x:String>End</x:String>
                                                    <x:String>Delete</x:String>
                                                    <x:String>Page Up</x:String>
                                                    <x:String>Page Down</x:String>
                                                    <x:String>F1</x:String>
                                                    <x:String>F2</x:String>
                                                    <x:String>F3</x:String>
                                                    <x:String>F4</x:String>
                                                    <x:String>F5</x:String>
                                                    <x:String>F6</x:String>
                                                    <x:String>F7</x:String>
                                                    <x:String>F8</x:String>
                                                    <x:String>F9</x:String>
                                                    <x:String>F10</x:String>
                                                    <x:String>F11</x:String>
                                                    <x:String>F12</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyOsHotkeyBtn" x:FieldModifier="internal"
                                                    Content="{Binding [Settings.Components.WriteKeyOptiScalerGames], Source={StaticResource Loc}}"
                                                    Click="ApplyOsHotkey_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="{Binding [Settings.Components.WritesOverlayKeyIntoOptiScaler], Source={StaticResource Loc}}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 8: TOOLS & MAINTENANCE
                             (Freeze Diagnostics, dev unlock only, is appended after this in SettingsHandler)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Tools" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Tools.Title], Source={StaticResource Loc}}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Settings.Tools.BulkActionsFoldersLogsLast], Source={StaticResource Loc}}"
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Tools -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding [Settings.Tools.Tools], Source={StaticResource Loc}}" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Deploy to many games (Mass INI + Mass Preset Install) -->
