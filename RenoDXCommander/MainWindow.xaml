                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Xaml.UiDesign], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                            <Run Text=" by Lazorr" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.SomehowIHaveBecomeA], Source={StaticResource Loc}}"/>
                                        <HyperlinkButton NavigateUri="https://github.com/lazorr410" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.HttpsGithubComLazorr410], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>

                                <!-- App author -->
                                <!-- Universal UE DOF Fix -->
                                <Border Background="{StaticResource SurfaceStatusBarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Xaml.UniversalUeDofFix], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                            <Run Text=" by Lazorr" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.FixesDepthOfFieldStepping], Source={StaticResource Loc}}"/>
                                        <HyperlinkButton NavigateUri="https://github.com/RankFTW/rhi-repo/releases" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.GithubComRankftwRhiRepo], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>

                                <!-- RHI -->
                                <Border Background="{StaticResource SurfaceStatusBarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="RHI" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                            <Run Text=" by RankFTW" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.UnofficialCompanionAppNotAffiliated], Source={StaticResource Loc}}"/>
                                        <HyperlinkButton NavigateUri="https://github.com/RankFTW" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.GithubComRankftw], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── Links ───────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding [Common.Links], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <HyperlinkButton NavigateUri="https://github.com/clshortfuse/renodx" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">RenoDX Project — github.com/clshortfuse/renodx</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://github.com/clshortfuse/renodx/wiki/Mods" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">RenoDX Mod Wiki</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://discord.gg/gF4GRJWZ2A" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">RenoDX Discord</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://discord.gg/k3cDruEQ" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">HDR Den Discord</TextBlock>
