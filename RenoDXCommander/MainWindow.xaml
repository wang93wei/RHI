                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailLumaLabel" x:FieldModifier="internal" Grid.Column="0" Text="{Binding [Detail.Luma], Source={StaticResource Loc}}" FontSize="12"
