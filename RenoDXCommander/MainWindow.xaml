                                            Foreground="{StaticResource ChipTextBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                            FontSize="11" HorizontalAlignment="Stretch"
                                            Click="FavouriteButton_Click"
                                            ToolTipService.ToolTip="{Binding [Xaml.ToggleFavourite], Source={StaticResource Loc}}">
                                        <TextBlock x:Name="DetailFavIcon" x:FieldModifier="internal" FontSize="11" Text="{Binding [Card.Favourite], Source={StaticResource Loc}}" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" x:Name="DetailAppDataBtn" x:FieldModifier="internal"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource ChipTextBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                            FontSize="11" HorizontalAlignment="Stretch"
