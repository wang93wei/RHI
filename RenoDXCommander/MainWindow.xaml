                                            <Run Text="{Binding [Xaml.NvapiwrapperNet], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" by falahati" Foreground="{StaticResource TextTertiaryBrush}"/>
