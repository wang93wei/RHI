                                        </ComboBox>
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CacheAllShadersCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="{Binding [Xaml.WhenOnAllShaderPacks], Source={StaticResource Loc}}"
                                                  SelectionChanged="CacheAllShadersCombo_SelectionChanged">
                                            <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Addon Watch Folder -->
                                <StackPanel Grid.Column="2" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.AddonWatchFolder], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.RhiWatchesThisFolderFor], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AddonWatchFolderBox" x:FieldModifier="internal"
                                                 Grid.Column="0"
                                                 PlaceholderText="{Binding [Xaml.DownloadsFolderDefault], Source={StaticResource Loc}}"
                                                 FontSize="12"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"/>
                                        <Button Grid.Column="1" Content="{Binding [Card.Browse], Source={StaticResource Loc}}" Click="BrowseAddonWatchFolder_Click"
                                                Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                                        <Button Grid.Column="2" Content="{Binding [Xaml.Reset], Source={StaticResource Loc}}" Click="ResetAddonWatchFolder_Click"
                                                Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextTertiaryBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 7: UPDATE & DEPLOYMENT
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Xaml.UpdateAmpDeployment], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Left: Global Update Checks -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding [Xaml.GlobalUpdateChecks], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Xaml.DisableUpdateChecksForIndividual], Source={StaticResource Loc}}"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Mass INI Deployment -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{Binding [Xaml.MassIniDeployment], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Xaml.DeployIniFilesOrReshade], Source={StaticResource Loc}}"/>
                                </StackPanel>

                                <!-- Row 1 Left: Update Inclusion button -->
                                <Button Grid.Row="1" Grid.Column="0" x:Name="GlobalUpdateInclusionBtn"
                                        Content="{Binding [Xaml.UpdateInclusion], Source={StaticResource Loc}}"
                                        Click="GlobalUpdateInclusion_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>

                                <!-- Row 1 Right: INI deploy buttons (2x2 grid) -->
                                <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="{Binding [Xaml.ReshadeIni], Source={StaticResource Loc}}" Click="MassDeployRsIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="{Binding [Xaml.RelimiterIni], Source={StaticResource Loc}}" Click="MassDeployUlIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="{Binding [Xaml.DcIni], Source={StaticResource Loc}}" Click="MassDeployDcIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="{Binding [Xaml.OptiscalerIni], Source={StaticResource Loc}}" Click="MassDeployOsIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding [Xaml.MassPresetInstall], Source={StaticResource Loc}}"
                                            Click="MassPresetInstall_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                </Grid>

                                <!-- Row 2 Left: Summary text -->
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GlobalUpdateSummaryText" x:FieldModifier="internal"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 8: SYSTEM & MAINTENANCE
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Xaml.SystemAmpMaintenance], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Full Refresh + Purge Staging -->
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="{Binding [Xaml.FullRefresh], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.ClearsAllCachesAndRe], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="FullRefreshBtn" Content="{Binding [Xaml.FullRefresh], Source={StaticResource Loc}}"
                                            Click="FullRefreshButton_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Xaml.DeletesCachedDlssStreamlineAnd], Source={StaticResource Loc}}"/>
                                    <Button Grid.Row="3" x:Name="PurgeCacheBtn"
                                            Content="{Binding [Xaml.PurgeStagingFiles], Source={StaticResource Loc}}"
                                            Click="PurgeCachedFiles_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="{Binding [Xaml.DeletesCachedDlssStreamlineAnd2], Source={StaticResource Loc}}"/>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Admin Mode + System Tray -->
                                <Grid Grid.Column="2" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Admin Mode description + combo -->
                                    <StackPanel Grid.Row="0" Spacing="4">
                                        <TextBlock Text="{Binding [Dialog.AdminMode.Title], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.CreatesAScheduledTaskTo], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding [Dialog.AdminMode.Title], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="AdminModeCombo" x:FieldModifier="internal"
                                                      SelectionChanged="AdminModeCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4"
                                                      CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                                <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding [Xaml.DropHelper], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="DropHelperCombo" x:FieldModifier="internal"
                                                      SelectionChanged="DropHelperCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4"
                                                      CornerRadius="8" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="{Binding [Xaml.TheDropHelperWindowEnables], Source={StaticResource Loc}}">
                                                <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                                <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <!-- System Tray description + combos -->
                                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
                                        <TextBlock Text="{Binding [Xaml.SystemTray], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.MinimizeToSystemTrayOn], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <Grid Grid.Row="3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding [Xaml.CloseToTray], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="CloseToTrayCombo" x:FieldModifier="internal"
                                                      SelectionChanged="CloseToTrayCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                                <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding [Xaml.RecentGames], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="RecentGamesCombo" x:FieldModifier="internal"
                                                      SelectionChanged="RecentGamesCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                                <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="{Binding [Xaml.StartWithWindows], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="StartWithWindowsCombo" x:FieldModifier="internal"
                                                      SelectionChanged="StartWithWindowsCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{Binding [Xaml.Off], Source={StaticResource Loc}}"/>
                                                <ComboBoxItem Content="{Binding [Xaml.On], Source={StaticResource Loc}}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 9: DATA & FOLDERS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding [Xaml.DataAmpCustomFiles], Source={StaticResource Loc}}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="20">
                                    All RHI data is stored in AppData. Drop custom ReShade, DLSS, or Streamline DLLs into the Custom folder to use them as per-game overrides. The Logs folder contains session usage logs useful for troubleshooting.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OpenAppDataBtn" Content="{Binding [Xaml.AppdataFolder], Source={StaticResource Loc}}" Click="OpenAppDataFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="OpenDownloadsBtn" Content="{Binding [Xaml.DownloadsFolder], Source={StaticResource Loc}}" Click="OpenDownloadsFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="OpenCustomBtn" Content="{Binding [Xaml.CustomFolder], Source={StaticResource Loc}}" Click="OpenCustomFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="OpenLogsBtn" Content="{Binding [Xaml.LogsFolder], Source={StaticResource Loc}}" Click="OpenLogsFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="CopyLogsArchiveBtn" Content="{Binding [Xaml.CopyLogs], Source={StaticResource Loc}}" Click="CopyLogsArchive_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"
                                            ToolTipService.ToolTip="{Binding [Xaml.CreatesAZipArchiveOf], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hidden combos retained for code-behind compatibility -->
                        <StackPanel Visibility="Collapsed">
                            <ComboBox x:Name="ReShadeChannelCombo" x:FieldModifier="internal"
                                      SelectionChanged="ReShadeChannelCombo_SelectionChanged">
                                <x:String>Stable (reshade.me releases)</x:String>
                                <x:String>Nightly (GitHub Actions builds)</x:String>
                            </ComboBox>
                            <ComboBox x:Name="DxvkVariantCombo" x:FieldModifier="internal"
                                      SelectionChanged="DxvkVariantCombo_SelectionChanged">
                                <x:String>Development (nightly builds)</x:String>
                                <x:String>Stable (tagged releases)</x:String>
                                <x:String>Lilium HDR</x:String>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end SettingsPanel -->

            <!--  ABOUT PANEL  -->
            <Grid x:Name="AboutPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="{Binding [Xaml.BackToGames], Source={StaticResource Loc}}"
                                Click="AboutBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding [Menu.About], Source={StaticResource Loc}}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable about content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,40" Spacing="14" MaxWidth="800"
                                HorizontalAlignment="Center">

                        <!-- ── About ───────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,4">
                                    <Image Source="icon.ico" Width="48" Height="48"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="RHI" Foreground="{StaticResource AccentTealBrush}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="AboutVersionText" x:FieldModifier="internal" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" LineHeight="20"
                                           Text="{Binding [Xaml.TheAllInOneGame], Source={StaticResource Loc}}"/>

                                <!-- What it does -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="14,10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.WhatRhiManages], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.ReshadeAmpShaderPacksRenodx], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Disclaimer -->
                                <!-- Single-player warning -->
                                <Border Background="{StaticResource AccentRedBgBrush}" CornerRadius="8" Padding="14,10"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [Xaml.SinglePlayerOnly], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [Xaml.RhiInstallsReshadeWithFull], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── Credits ─────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding [Xaml.CreditsAmpAcknowledgements], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="20"
                                           Text="{Binding [Xaml.ThisAppWouldNotExist], Source={StaticResource Loc}}"/>

                                <!-- RenoDX -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Detail.RenoDX], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}"/>
                                            <Run Text=" by clshortfuse &amp; contributors" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <Run Text="  ·  MIT Licence" Foreground="{StaticResource InlineDescriptionBrush}" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Margin="0,0,0,0" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.HdrModFrameworkPowering800], Source={StaticResource Loc}}"/>
                                        <HyperlinkButton NavigateUri="https://github.com/clshortfuse/renodx" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.GithubComClshortfuseRenodx], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>

                                <!-- ReShade -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Detail.ReShade], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" by Crosire" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <Run Text="  ·  BSD 3-Clause Licence" Foreground="{StaticResource InlineDescriptionBrush}" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.PostProcessingInjectionFrameworkDownload], Source={StaticResource Loc}}"/>
                                        <HyperlinkButton NavigateUri="https://reshade.me" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.ReshadeMeGithubComCrosire], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
