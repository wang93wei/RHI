                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">ReShade — reshade.me</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://github.com/Filoppi/Luma-Framework" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">Luma Framework — github.com/Filoppi/Luma-Framework</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://github.com/pmnoxx/display-commander" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">Display Commander — github.com/pmnoxx/display-commander</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://www.hdrmods.com/" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">Creepy's HDR Guides — hdrmods.com</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://discord.gg/pQtPYcdE" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">The Ultra Place / Ultra+ Discord</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://github.com/RankFTW" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">RankFTW GitHub</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://github.com/praydog/REFramework-nightly" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">RE Framework — github.com/praydog/REFramework-nightly</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://github.com/optiscaler/OptiScaler" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentBlueBrush}" FontSize="12">OptiScaler — github.com/optiscaler/OptiScaler</TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton NavigateUri="https://ko-fi.com/rankftw" Padding="0">
                                    <TextBlock Foreground="{StaticResource AccentRedBrush}" FontSize="12">Support RHI on Ko-Fi</TextBlock>
                                </HyperlinkButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end AboutPanel -->

            <!--  FAQ PANEL  -->
            <Grid x:Name="FaqPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="{Binding [Xaml.BackToGames], Source={StaticResource Loc}}"
                                Click="FaqBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding [Xaml.QuickStartGuide], Source={StaticResource Loc}}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable FAQ content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FaqContentPanel" x:FieldModifier="internal" Padding="32,24,32,40" Spacing="14" MaxWidth="900"
                                HorizontalAlignment="Center"/>
                </ScrollViewer>
            </Grid>

            <!-- end FaqPanel -->
        </Grid>

        <!-- end Row 1 content area -->

        <!--  ROW 2: STATUS BAR  -->
        <Border Grid.Row="2" Padding="20,6" Background="{StaticResource SurfaceStatusBarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusBarText" Text=""
                           FontSize="11" Foreground="{StaticResource TextDisabledBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="10" Foreground="{StaticResource AccentAmberDimBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           Text="{Binding [Xaml.ReshadeOptiscalerAndDlssStreamline], Source={StaticResource Loc}}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Spacing="8">
                    <TextBlock x:Name="StatusBarVersionText" x:FieldModifier="internal"
                               FontSize="11" Foreground="{StaticResource TextDisabledBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="{Binding [Xaml.PatchNotes], Source={StaticResource Loc}}"
                            Click="PatchNotesLink_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDisabledBrush}" FontSize="11"
                            Padding="8,2" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{Binding [Xaml.ViewRecentPatchNotes], Source={StaticResource Loc}}"/>
                    <Button Content="{Binding [Xaml.Motd], Source={StaticResource Loc}}"
                            Click="MotdButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDisabledBrush}" FontSize="11"
                            Padding="8,2" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{Binding [Xaml.ShowMessageOfTheDay], Source={StaticResource Loc}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- (Old card DataTemplate removed — detail panel is now built in code-behind) -->
    </Grid>
</Window>
