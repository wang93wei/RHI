                                        <TextBlock Text="{Binding [Card.Bitness32], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource AccentAmberBrush}"/>
                                    </Border>
                                    <Border x:Name="Detail64BitBadge" x:FieldModifier="internal" CornerRadius="5" Padding="6,2"
                                            Background="{StaticResource ChipDefaultBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{Binding [Card.Bitness64], Source={StaticResource Loc}}" FontSize="11" Foreground="{StaticResource ChipTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            </Border>
                            <!-- Right box: Hide, Favourite, Config, Browse -->
                            <Border Grid.Column="1" Background="{StaticResource SurfaceComponentTableBrush}"
