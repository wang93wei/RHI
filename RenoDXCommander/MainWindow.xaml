                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.GithubComPmnoxxDisplayCommander], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>

                                <!-- RE Framework -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Detail.REFramework], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" by praydog" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <Run Text="  ·  MIT Licence" Foreground="{StaticResource InlineDescriptionBrush}" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.ModdingFrameworkRequiredForReshade], Source={StaticResource Loc}}"/>
                                        <HyperlinkButton NavigateUri="https://github.com/praydog/REFramework-nightly" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="{Binding [Xaml.GithubComPraydogReframeworkNightly], Source={StaticResource Loc}}"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>

                                <!-- OptiScaler -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Detail.OptiScaler], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" by OptiScaler contributors" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <Run Text="  ·  Source-available" Foreground="{StaticResource InlineDescriptionBrush}" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="{Binding [Xaml.UpscalerRedirectionLayerEnablingDlss], Source={StaticResource Loc}}"/>
