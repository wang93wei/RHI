                                <!-- Display Commander -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding [Detail.DisplayCommander], Source={StaticResource Loc}}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" by pmnox" Foreground="{StaticResource TextTertiaryBrush}"/>
