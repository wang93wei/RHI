<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RenoDXCommander.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RenoDXCommander.ViewModels"
    xmlns:converters="using:RenoDXCommander.Converters"
    xmlns:controls="using:RenoDXCommander.Controls"
    Title="RHI">
    <Grid RequestedTheme="Dark" Background="{StaticResource SurfaceBaseBrush}" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
        <Grid.Resources>
            <x:Double x:Key="CardItemWidth">390</x:Double>
            <x:Double x:Key="CompactCardWidth">400</x:Double>
            <converters:BoolToVisibility x:Key="BoolToVisibility"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Toolbar -->
            <RowDefinition Height="*"/>     <!-- Row 1: Content (GameView or Settings) -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Status Bar -->
        </Grid.RowDefinitions>

        <!--  ROW 0: TOOLBAR  -->
        <Border Grid.Row="0" Padding="16,10" Background="{StaticResource SurfaceHeaderBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Logo + title -->
                    <ColumnDefinition Width="*"/>     <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>  <!-- Action buttons -->
                </Grid.ColumnDefinitions>

                <!-- Logo + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8">
                        <Image Source="icon.ico" Width="36" Height="36" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold">
                            <Run Text="RHI" Foreground="{StaticResource AccentTealBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding [App.Subtitle], Source={StaticResource Loc}}" FontSize="10" Foreground="{StaticResource AccentTealDimBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="NewModsBtn" Content="{Binding [Common.NewMods], Source={StaticResource Loc}}"
                            Click="NewModsButton_Click"
                            Visibility="{x:Bind ViewModel.NewWikiModsButtonVisibility, Mode=OneWay}"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentGreenBrush}"
                            BorderBrush="{StaticResource AccentGreenBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.NewRenodxModsHaveBeen], Source={StaticResource Loc}}"/>
                    <Button x:Name="FaqBtn" Content="{Binding [Common.QuickStart], Source={StaticResource Loc}}"
                            Click="FaqButton_Click"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.QuickStartGuide], Source={StaticResource Loc}}"/>

                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="4,0"/>

                    <Button x:Name="RefreshBtn" Content="{Binding [Common.Refresh], Source={StaticResource Loc}}"
                            Click="RefreshButton_Click"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.RescanGameLibraryAndFetch], Source={StaticResource Loc}}"/>
                    <Button x:Name="ShadersAddonsBtn" Content="{Binding [Common.ShadersAddons], Source={StaticResource Loc}}"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.ManageGlobalShadersAndReshade], Source={StaticResource Loc}}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="ChooseShadersItem" Text="{Binding [Menu.GlobalShaders], Source={StaticResource Loc}}" Click="ChooseShadersButton_Click"/>
                                <MenuFlyoutItem x:Name="ReShadeAddonsItem" Text="{Binding [Menu.ReShadeAddons], Source={StaticResource Loc}}" Click="ReShadeAddonsButton_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="4,0"/>

                    <Button x:Name="UpdateBtn" Content="{Binding [Common.UpdateAll], Source={StaticResource Loc}}"
                            Click="UpdateAllButton_Click"
                            Background="{StaticResource SurfaceInputBrush}"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{x:Bind ViewModel.UpdateButtonTooltip, Mode=OneWay}"/>

                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="4,0"/>

                    <Button x:Name="LinksBtn" Content="{Binding [Common.Links], Source={StaticResource Loc}}"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.UsefulLinksAndResources], Source={StaticResource Loc}}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{Binding [Menu.RenoDxWiki], Source={StaticResource Loc}}" Click="LinkRenoDxWiki_Click"/>
                                <MenuFlyoutItem Text="{Binding [Menu.LumaWiki], Source={StaticResource Loc}}" Click="LinkLumaWiki_Click"/>
                                <MenuFlyoutItem Text="{Binding [Menu.RhiGithub], Source={StaticResource Loc}}" Click="LinkRhiGithub_Click"/>
                                <MenuFlyoutItem Text="{Binding [Menu.ReLimiterGithub], Source={StaticResource Loc}}" Click="LinkReLimiterGithub_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SupportBtn" Content="{Binding [Common.Help], Source={StaticResource Loc}}"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.SupportAndHelpResources], Source={StaticResource Loc}}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{Binding [Menu.Discord], Source={StaticResource Loc}}" Click="SupportDiscord_Click"/>
                                <MenuFlyoutItem Text="{Binding [Menu.Guide], Source={StaticResource Loc}}" Click="SupportGuide_Click"/>
                                <MenuFlyoutItem Text="{Binding [Common.Donate], Source={StaticResource Loc}}" Click="SupportKofi_Click"/>
                                <MenuFlyoutItem Text="{Binding [Menu.About], Source={StaticResource Loc}}" Click="AboutButton_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="4,0"/>

                    <Button x:Name="LayoutToggleBtn" Content="{x:Bind ViewModel.LayoutToggleLabel, Mode=OneWay}"
                            Click="LayoutToggle_Click"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.ToggleBetweenDetailAndSimple], Source={StaticResource Loc}}"/>
                    <Button x:Name="SettingsBtn" Content="{Binding [Common.Settings], Source={StaticResource Loc}}"
                            Click="SettingsButton_Click" IsEnabled="False"
                            Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" FontSize="12"
                            ToolTipService.ToolTip="{Binding [Xaml.OpenSettings], Source={StaticResource Loc}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ROW 1: CONTENT AREA  -->
        <Grid Grid.Row="1">

            <!-- Loading overlay -->
            <StackPanel x:Name="LoadingPanel" x:FieldModifier="internal" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="16" Visibility="Collapsed" Canvas.ZIndex="10">
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="48" Height="48"
                              Foreground="{StaticResource AccentBlueBrush}"/>
                <TextBlock x:Name="LoadingTitle" Text="{Binding [Loading.Title], Source={StaticResource Loc}}" FontSize="16"
                           Foreground="{StaticResource ChipTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingSubtitle" Text="" FontSize="12"
                           Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!--  GAME VIEW PANEL  -->
            <Grid x:Name="GameViewPanel" x:FieldModifier="internal" Visibility="Visible" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Detail Panel -->
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR (Column 0) ──────────────────────────────────────── -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Search box -->
                            <RowDefinition Height="Auto"/>  <!-- Filter chips -->
                            <RowDefinition Height="Auto"/>  <!-- Counts -->
                            <RowDefinition Height="*"/>     <!-- Game list -->
                        </Grid.RowDefinitions>

                        <!-- Search box -->
                        <Border Grid.Row="0" Padding="10,8,10,4" Background="{StaticResource SurfaceToolbarBrush}">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Grid.Column="0"
                                         PlaceholderText="{Binding [Filter.Placeholder], Source={StaticResource Loc}}"
                                         TextChanged="SearchBox_TextChanged"
                                         Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                         CornerRadius="8" Padding="10,7"
                                         FontSize="12"/>
                                <Button x:Name="SaveFilterButton" Grid.Column="1"
                                        Content="+"
                                        Click="SaveFilterButton_Click"
                                        Visibility="Collapsed"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        Foreground="{StaticResource AccentTealBrush}"
                                        BorderBrush="{StaticResource AccentTealBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8" Padding="8,6"
                                        MinWidth="0" MinHeight="0"
                                        FontSize="14" FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{Binding [Filter.Search.Saved], Source={StaticResource Loc}}"/>
                                <Button x:Name="AddGameBtn" Grid.Column="2"
                                        Content="+"
                                        Click="AddGameButton_Click"
                                        Background="{StaticResource AccentGreenBgBrush}"
                                        Foreground="{StaticResource AccentGreenBrush}"
                                        BorderBrush="{StaticResource AccentGreenBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8" Padding="8,6"
                                        MinWidth="0" MinHeight="0"
                                        FontSize="14" FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{Binding [Filter.Search.AddGame], Source={StaticResource Loc}}"/>
                            </Grid>
                        </Border>

                        <!-- Filter chips -->
                        <Border Grid.Row="1" Padding="10,8" Background="{StaticResource SurfaceToolbarBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="FilterDetected" Content="{Binding [Filter.AllGames], Source={StaticResource Loc}}" Tag="Detected"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipActiveBrush}" Foreground="White"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterInstalled" Content="{Binding [Filter.Installed], Source={StaticResource Loc}}" Tag="Installed"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterFavourites" Content="{Binding [Filter.Favourites], Source={StaticResource Loc}}" Tag="Favourites"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterHidden" Content="{Binding [Filter.Hidden], Source={StaticResource Loc}}" Tag="Hidden"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="FilterUnreal" Content="{Binding [Filter.Unreal], Source={StaticResource Loc}}" Tag="Unreal"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterUnity" Content="{Binding [Filter.Unity], Source={StaticResource Loc}}" Tag="Unity"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterOther" Content="{Binding [Filter.Other], Source={StaticResource Loc}}" Tag="Other"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterRenoDX" Content="{Binding [Detail.RenoDX], Source={StaticResource Loc}}" Tag="RenoDX"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                    <Button x:Name="FilterLuma" Content="{Binding [Detail.Luma], Source={StaticResource Loc}}" Tag="Luma"
                                            Click="Filter_Click"
                                            Background="{StaticResource ChipDefaultBrush}" Foreground="{StaticResource ChipTextBrush}"
                                            BorderThickness="0" CornerRadius="7" Padding="10,5" FontSize="11"/>
                                </StackPanel>
                                <!-- Custom filter chips (populated programmatically) -->
                                <controls:WrapPanel x:Name="CustomFilterChipPanel" x:FieldModifier="internal"
                                                    HorizontalSpacing="4" VerticalSpacing="4"/>
                            </StackPanel>
                        </Border>

                        <!-- Game/installed counts -->
                        <Border Grid.Row="2" Padding="12,4,12,4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource AccentGreenDimBrush}"/>
                                <TextBlock x:Name="GameCountText" Text="{Binding [Xaml.0Shown], Source={StaticResource Loc}}"
                                           FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InstalledCountText" Text="{Binding [Xaml.0Installed], Source={StaticResource Loc}}"
                                           FontSize="11" Foreground="{StaticResource AccentGreenDimBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HiddenCountText" Text=""
                                           FontSize="11" Foreground="{StaticResource AccentPurpleDimBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Game ListView -->
                        <ListView x:Name="GameList" Grid.Row="3"
                                  SelectionChanged="GameList_SelectionChanged"
                                  DoubleTapped="GameList_DoubleTapped"
                                  Background="Transparent"
                                  SelectionMode="Single" Padding="4">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0AFFFFFF"/>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameCardViewModel">
                                    <Border Background="{x:Bind SidebarItemBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind SidebarItemBorderBrush, Mode=OneWay}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="16" VerticalAlignment="Center">
                                                <Image Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       Visibility="{x:Bind SourceIconImageVisibility}">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind SourceIconUri}"/>
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock Text="{x:Bind SourceIcon}" FontSize="11"
                                                           Visibility="{x:Bind SourceIconTextVisibility}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind GameName}" FontSize="12"
                                                       Foreground="{x:Bind SidebarItemForeground, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" VerticalAlignment="Center"/>

                                            <!-- Update badge dot -->
                                            <Ellipse Grid.Column="2" Width="8" Height="8"
                                                     Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center"
                                                     Margin="4,0,2,0"
                                                     Visibility="{x:Bind UpdateBadgeVisibility, Mode=OneWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Skeleton rows overlay (removed programmatically after first load) -->
                        <StackPanel x:Name="SkeletonRowPanel" Grid.Row="3" Spacing="4" Padding="4"
                                    Visibility="Visible"/>
                    </Grid>
                </Border>

                <!-- ── CONTENT COLUMN (Column 1): Detail Panel / Card Grid ────── -->
                <Grid Grid.Column="1">
                    <!-- Detail Panel (existing) — visible in Detail and Compact modes -->
                    <ScrollViewer x:Name="DetailScrollViewer" x:FieldModifier="internal"
                                  Visibility="{x:Bind ViewModel.DetailOrCompactVisibility, Mode=OneWay}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="DetailScrollViewer_SizeChanged">
                    <StackPanel x:Name="DetailPanel" x:FieldModifier="internal" Spacing="16" Visibility="Collapsed"
                                Padding="24,18,24,24" HorizontalAlignment="Center">

                        <!-- ── Game name + author row (above card) ── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Bottom">
                                <TextBlock x:Name="DetailGameName" x:FieldModifier="internal" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="DetailInstallPath" x:FieldModifier="internal" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Author badges (right-aligned, above card) -->
                            <StackPanel Grid.Column="1" x:Name="DetailAuthorBadgePanel" x:FieldModifier="internal" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>

                        <!-- ── Game info card (action buttons + badges) ── -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left box: Launch, links, badges -->
                            <Border Grid.Column="0" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="10">
                                <!-- Action buttons row -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="DetailLaunchBtn" x:FieldModifier="internal"
                                                Background="#1A3A20"
                                                Foreground="#6AE87A"
                                                BorderBrush="#2A5A30" BorderThickness="1"
                                                CornerRadius="6" Padding="10,4" MinWidth="0" MinHeight="0"
                                                FontSize="11" FontWeight="SemiBold"
                                                Click="LaunchGame_Click"
                                                ToolTipService.ToolTip="{Binding [Xaml.LaunchThisGame], Source={StaticResource Loc}}">
                                            <TextBlock Text="{Binding [Card.Launch], Source={StaticResource Loc}}" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="DetailHdrToggleBtn" x:FieldModifier="internal"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="11"
                                                Click="HdrToggle_Click"
                                                ToolTipService.ToolTip="{Binding [Xaml.TogglePerGameHdrAuto], Source={StaticResource Loc}}">
                                            <TextBlock x:Name="DetailHdrToggleText" x:FieldModifier="internal" FontSize="11" Text="{Binding [Card.HDR], Source={StaticResource Loc}}"/>
                                        </Button>
                                        <Button x:Name="DetailResToggleBtn" x:FieldModifier="internal"
                                                Visibility="Collapsed"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="11"
                                                Click="ResToggle_Click"
                                                ToolTipService.ToolTip="{Binding [Xaml.TogglePerGameResolutionSwitch], Source={StaticResource Loc}}">
                                            <TextBlock x:Name="DetailResToggleText" x:FieldModifier="internal" FontSize="11" Text="{Binding [Card.RES], Source={StaticResource Loc}}"/>
                                        </Button>
                                        <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                        <Button x:Name="DetailNexusModsBtn" x:FieldModifier="internal"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="11"
                                                Click="NexusModsLink_Click"
                                                Visibility="Collapsed"
                                                ToolTipService.ToolTip="{Binding [Xaml.OpenNexusModsPage], Source={StaticResource Loc}}">
                                            <TextBlock Text="{Binding [Xaml.Nexus], Source={StaticResource Loc}}" TextDecorations="Underline"/>
                                        </Button>
                                        <Button x:Name="DetailPcgwBtn" x:FieldModifier="internal"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="11"
                                                Click="PcgwLink_Click"
                                                Visibility="Collapsed"
                                                ToolTipService.ToolTip="{Binding [Xaml.OpenPcgamingwikiPage], Source={StaticResource Loc}}">
                                            <TextBlock Text="{Binding [Xaml.Pcgw], Source={StaticResource Loc}}" TextDecorations="Underline"/>
                                        </Button>
                                        <Button x:Name="DetailUwFixBtn" x:FieldModifier="internal"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="11"
                                                Click="UwFixLink_Click"
                                                Visibility="Collapsed"
                                                ToolTipService.ToolTip="{Binding [Xaml.OpenUltrawideFixPage], Source={StaticResource Loc}}">
                                            <TextBlock Text="{Binding [Xaml.UwFix], Source={StaticResource Loc}}" TextDecorations="Underline"/>
                                        </Button>
                                        <Button x:Name="DetailUltraPlusBtn" x:FieldModifier="internal"
                                                Background="{StaticResource SurfaceOverlayBrush}"
                                                Foreground="{StaticResource ChipTextBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                FontSize="11"
                                                Click="UltraPlusLink_Click"
                                                Visibility="Collapsed"
                                                ToolTipService.ToolTip="{Binding [Xaml.OpenUltraPageForThis], Source={StaticResource Loc}}">
                                            <TextBlock Text="{Binding [Xaml.Ultra], Source={StaticResource Loc}}" TextDecorations="Underline"/>
                                        </Button>
                                    </StackPanel>

                                <!-- Addon file + info badges with Browse button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:WrapPanel Grid.Column="0" HorizontalSpacing="8" VerticalSpacing="6">
                                    <!-- Group 1: Mod info (addon file + generic/extended badge) -->
                                    <Border x:Name="DetailInstalledFileBadge" x:FieldModifier="internal" CornerRadius="5" Padding="6,2"
                                            Background="{StaticResource ChipDefaultBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailInstalledFile" x:FieldModifier="internal" FontSize="11" Foreground="{StaticResource ChipTextBrush}"/>
                                    </Border>
                                    <Border x:Name="DetailGenericBadge" x:FieldModifier="internal" CornerRadius="5" Padding="6,2"
                                            Background="{StaticResource ChipDefaultBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailGenericText" x:FieldModifier="internal" FontSize="11" Foreground="{StaticResource ChipTextBrush}"/>
                                    </Border>

                                    <!-- Separator: mod → platform -->
