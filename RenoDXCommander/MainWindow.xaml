                                        <TextBlock x:Name="DetailComponentsArrow" x:FieldModifier="internal"
                                                   Text="▼" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="DetailComponentsTitle" x:FieldModifier="internal"
                                                   Text="{Binding [Detail.Components], Source={StaticResource Loc}}" FontSize="13" FontWeight="SemiBold"
